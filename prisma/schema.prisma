generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  COLLEGE_ADMIN
  SATTVIC_ADMIN
  VOLUNTEER
  STUDENT
  DONOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
  PENDING
}

enum VolunteerApproval {
  PENDING
  APPROVED
  REJECTED
}

enum MealTime {
  BREAKFAST
  LUNCH
  DINNER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DeliveryType {
  VOLUNTEER_DELIVERY
  SELF_PICKUP
  WALK_IN
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// ─── USERS (merged admin_users + customers) ─────────────────────────────────

model User {
  id                  Int               @id @default(autoincrement())
  email               String            @unique
  password            String            // bcrypt hash
  legacyMd5Password   String?           // for migration: old MD5 hash
  firstName           String
  lastName            String
  phone               String?
  gender              Gender?
  role                Role              @default(STUDENT)
  status              UserStatus        @default(ACTIVE)
  emailVerified       DateTime?
  image               String?           @db.Text
  qrCode              String?           @unique // unique QR identifier

  // Volunteer-specific
  volunteerApproval   VolunteerApproval? @default(PENDING)
  volunteerApprovedAt DateTime?
  volunteerApprovedBy Int?

  // College association
  collegeId           Int?
  college             College?          @relation(fields: [collegeId], references: [id])

  // OTP
  otpCode             String?
  otpExpiresAt        DateTime?

  // Timestamps
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lastLoginAt         DateTime?

  // Relations
  mealRequests        MealRequest[]
  deliveriesAsStudent Delivery[]        @relation("StudentDeliveries")
  deliveriesAsDriver  Delivery[]        @relation("VolunteerDeliveries")
  packageCounts       MealPackageCount[]
  volunteerAvailability VolunteerAvailability[]
  donations           Donation[]
  sessions            Session[]
  accounts            Account[]
  createdPages        Page[]            @relation("PageCreatedBy")
  modifiedPages       Page[]            @relation("PageModifiedBy")
  createdNews         News[]            @relation("NewsCreatedBy")
  modifiedNews        News[]            @relation("NewsModifiedBy")
  createdEvents       Event[]           @relation("EventCreatedBy")
  modifiedEvents      Event[]           @relation("EventModifiedBy")
  createdBlogs        Blog[]            @relation("BlogCreatedBy")
  modifiedBlogs       Blog[]            @relation("BlogModifiedBy")
  eventRegistrations  EventRegistration[]
  contactMessages     Contact[]

  @@index([role])
  @@index([collegeId])
  @@index([status])
  @@map("users")
}

// ─── AUTH.JS REQUIRED TABLES ─────────────────────────────────────────────────

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── ORGANIZATION ────────────────────────────────────────────────────────────

model College {
  id          Int      @id @default(autoincrement())
  name        String
  domain      String?  // e.g. "university.edu"
  email       String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  locations   Location[]
  packageCounts MealPackageCount[]

  @@map("colleges")
}

model Location {
  id          Int      @id @default(autoincrement())
  name        String
  address     String?  @db.Text
  collegeId   Int
  college     College  @relation(fields: [collegeId], references: [id])
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mealRequests        MealRequest[]
  deliveries          Delivery[]
  packageCounts       MealPackageCount[]
  volunteerAvailability VolunteerAvailability[]

  @@index([collegeId])
  @@map("locations")
}

model Kitchen {
  id          Int      @id @default(autoincrement())
  name        String
  address     String?  @db.Text
  contactName String?
  contactPhone String?
  contactEmail String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("kitchens")
}

model Chapter {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.Text
  imagePath   String?
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images      ChapterImage[]

  @@map("chapters")
}

model ChapterImage {
  id        Int     @id @default(autoincrement())
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  imagePath String
  imageType String? // e.g. "banner", "gallery"
  altText   String?
  sortOrder Int     @default(0)

  @@index([chapterId])
  @@map("chapter_images")
}

// ─── MEAL SYSTEM ─────────────────────────────────────────────────────────────

model MealTimetable {
  id        Int        @id @default(autoincrement())
  mealTime  MealTime
  day       DayOfWeek
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([mealTime, day])
  @@map("meal_timetables")
}

model MealRequest {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  locationId      Int
  location        Location  @relation(fields: [locationId], references: [id])
  requestDate     DateTime  @db.Date
  day             DayOfWeek
  mealTime        MealTime
  startDate       DateTime? @db.Date // for recurring requests
  endDate         DateTime? @db.Date
  isRecurring     Boolean   @default(false)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  delivery        Delivery?

  @@index([userId])
  @@index([locationId])
  @@index([requestDate])
  @@index([mealTime, requestDate])
  @@map("meal_requests")
}

model Delivery {
  id            Int          @id @default(autoincrement())
  deliveryDate  DateTime     @db.Date
  mealTime      MealTime
  deliveryType  DeliveryType @default(VOLUNTEER_DELIVERY)

  // For registered students
  studentId     Int?
  student       User?        @relation("StudentDeliveries", fields: [studentId], references: [id])
  mealRequestId Int?         @unique
  mealRequest   MealRequest? @relation(fields: [mealRequestId], references: [id])

  // For walk-in / non-registered (combined from not_registered_deliveries)
  walkInCount   Int          @default(0) // number of packages for non-registered

  // Volunteer who delivered
  volunteerId   Int
  volunteer     User         @relation("VolunteerDeliveries", fields: [volunteerId], references: [id])

  locationId    Int
  location      Location     @relation(fields: [locationId], references: [id])

  notes         String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([deliveryDate])
  @@index([studentId])
  @@index([volunteerId])
  @@index([locationId])
  @@index([mealTime, deliveryDate])
  @@map("deliveries")
}

model MealPackageCount {
  id                      Int      @id @default(autoincrement())
  date                    DateTime @db.Date
  day                     DayOfWeek
  mealTime                MealTime
  locationId              Int
  location                Location @relation(fields: [locationId], references: [id])
  collegeId               Int
  college                 College  @relation(fields: [collegeId], references: [id])
  volunteerId             Int
  volunteer               User     @relation(fields: [volunteerId], references: [id])
  mealsDelivered          Int      @default(0)
  extraPackagesDelivered  Int      @default(0)
  mealsCancelled          Int      @default(0)
  mealsReturned           Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([date])
  @@index([locationId])
  @@index([collegeId])
  @@map("meal_package_counts")
}

model VolunteerAvailability {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  locationId  Int
  location    Location @relation(fields: [locationId], references: [id])
  date        DateTime @db.Date
  mealTime    MealTime
  isAssigned  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([locationId])
  @@index([date])
  @@map("volunteer_availability")
}

// ─── DONATIONS ───────────────────────────────────────────────────────────────

model Campaign {
  id          Int           @id @default(autoincrement())
  name        String
  slug        String        @unique
  description String?       @db.Text
  imagePath   String?
  goalAmount  Decimal       @default(0) @db.Decimal(10, 2)
  raisedAmount Decimal      @default(0) @db.Decimal(10, 2)
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  isActive    Boolean       @default(true)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  donations   Donation[]

  @@map("campaigns")
}

model Donation {
  id                Int              @id @default(autoincrement())
  amount            Decimal          @db.Decimal(10, 2)
  currency          String           @default("USD")
  status            DonationStatus   @default(PENDING)
  frequency         DonationFrequency @default(ONE_TIME)

  // Donor (nullable for anonymous)
  userId            Int?
  user              User?            @relation(fields: [userId], references: [id])
  donorName         String?
  donorEmail        String?
  donorPhone        String?

  // Campaign (nullable for general donations)
  campaignId        Int?
  campaign          Campaign?        @relation(fields: [campaignId], references: [id])

  // Stripe
  stripePaymentId   String?          @unique
  stripeCustomerId  String?
  stripeSubscriptionId String?

  // Receipt
  receiptSent       Boolean          @default(false)
  receiptSentAt     DateTime?

  // Metadata
  notes             String?          @db.Text
  isAnonymous       Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@map("donations")
}

// ─── CMS CONTENT ─────────────────────────────────────────────────────────────

model Page {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  content         String?       @db.LongText
  excerpt         String?       @db.Text
  featuredImage   String?
  status          ContentStatus @default(DRAFT)

  // SEO
  metaTitle       String?
  metaDescription String?       @db.Text
  metaKeywords    String?       @db.Text
  canonicalUrl    String?
  noIndex         Boolean       @default(false)
  noFollow        Boolean       @default(false)

  // Audit
  createdById     Int?
  createdBy       User?         @relation("PageCreatedBy", fields: [createdById], references: [id])
  modifiedById    Int?
  modifiedBy      User?         @relation("PageModifiedBy", fields: [modifiedById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("pages")
}

model News {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  shortDesc       String?       @db.Text
  content         String?       @db.LongText
  imagePath       String?
  publishDate     DateTime      @default(now())
  status          ContentStatus @default(DRAFT)

  // SEO
  metaTitle       String?
  metaDescription String?       @db.Text
  metaKeywords    String?       @db.Text
  canonicalUrl    String?
  noIndex         Boolean       @default(false)
  noFollow        Boolean       @default(false)

  // Audit
  createdById     Int?
  createdBy       User?         @relation("NewsCreatedBy", fields: [createdById], references: [id])
  modifiedById    Int?
  modifiedBy      User?         @relation("NewsModifiedBy", fields: [modifiedById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("news")
}

model Blog {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  shortDesc       String?       @db.Text
  content         String?       @db.LongText
  imagePath       String?
  publishDate     DateTime      @default(now())
  status          ContentStatus @default(DRAFT)

  // Category + Tags (simplified from old 3-table structure)
  category        String?
  tags            String?       @db.Text // JSON array of tags

  // SEO
  metaTitle       String?
  metaDescription String?       @db.Text
  metaKeywords    String?       @db.Text

  // Audit
  createdById     Int?
  createdBy       User?         @relation("BlogCreatedBy", fields: [createdById], references: [id])
  modifiedById    Int?
  modifiedBy      User?         @relation("BlogModifiedBy", fields: [modifiedById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("blogs")
}

model Event {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  shortDesc       String?       @db.Text
  content         String?       @db.LongText
  imagePath       String?
  eventDate       DateTime
  endDate         DateTime?
  venue           String?
  status          ContentStatus @default(DRAFT)

  // SEO
  metaTitle       String?
  metaDescription String?       @db.Text
  metaKeywords    String?       @db.Text

  // Audit
  createdById     Int?
  createdBy       User?         @relation("EventCreatedBy", fields: [createdById], references: [id])
  modifiedById    Int?
  modifiedBy      User?         @relation("EventModifiedBy", fields: [modifiedById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  registrations   EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("event_registrations")
}

model Story {
  id          Int           @id @default(autoincrement())
  title       String
  slug        String        @unique
  content     String?       @db.LongText
  excerpt     String?       @db.Text
  imagePath   String?
  authorName  String?
  status      ContentStatus @default(DRAFT)
  publishDate DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("stories")
}

model Gallery {
  id          Int           @id @default(autoincrement())
  title       String
  slug        String        @unique
  description String?       @db.Text
  coverImage  String?
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  images      GalleryImage[]

  @@map("galleries")
}

model GalleryImage {
  id          Int      @id @default(autoincrement())
  galleryId   Int
  gallery     Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  imagePath   String
  altText     String?
  caption     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([galleryId])
  @@map("gallery_images")
}

// ─── SUPPORT / ENGAGEMENT ────────────────────────────────────────────────────

model Faq {
  id          Int           @id @default(autoincrement())
  question    String        @db.Text
  answer      String        @db.LongText
  category    String?
  sortOrder   Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("faqs")
}

model Testimonial {
  id          Int           @id @default(autoincrement())
  name        String
  role        String?       // e.g. "Student", "Volunteer", "Donor"
  content     String        @db.Text
  imagePath   String?
  rating      Int?          @default(5)
  status      ContentStatus @default(PUBLISHED)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("testimonials")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([isRead])
  @@map("contacts")
}

model Newsletter {
  id          Int           @id @default(autoincrement())
  title       String
  content     String        @db.LongText
  sentAt      DateTime?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("newsletters")
}

// ─── ORGANIZATIONAL ──────────────────────────────────────────────────────────

model TeamMember {
  id          Int           @id @default(autoincrement())
  name        String
  title       String?
  bio         String?       @db.Text
  imagePath   String?
  teamType    String        // e.g. "leadership", "advisory", "staff"
  sortOrder   Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("team_members")
}

model Supporter {
  id          Int           @id @default(autoincrement())
  name        String
  logoPath    String?
  website     String?
  supportType String?       // e.g. "corporate", "foundation", "individual"
  sortOrder   Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("supporters")
}

model Award {
  id          Int           @id @default(autoincrement())
  title       String
  description String?       @db.Text
  imagePath   String?
  awardDate   DateTime?
  status      ContentStatus @default(PUBLISHED)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("awards")
}

model FinancialReport {
  id          Int           @id @default(autoincrement())
  title       String
  year        Int
  description String?       @db.Text
  filePath    String        // PDF attachment
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("financial_reports")
}

// ─── SITE CONFIG ─────────────────────────────────────────────────────────────

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.LongText

  @@map("settings")
}

model Banner {
  id          Int           @id @default(autoincrement())
  title       String?
  subtitle    String?
  imagePath   String
  linkUrl     String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("banners")
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique // e.g. "welcome", "otp", "donation_receipt"
  subject     String
  body        String   @db.LongText // HTML template with {{placeholders}}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  menuGroup   String   // e.g. "header", "footer"
  label       String
  href        String
  parentId    Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([menuGroup])
  @@map("menu_items")
}
